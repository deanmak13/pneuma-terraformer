# Terraform CLI configuration — baked into the image at /app/tf/cli.tfrc
# and wired via TF_CLI_CONFIG_FILE (see settings.tf_cli_config_file /
# TerraformRunner._spawn()).
#
# Points every provider install at the filesystem mirror baked in the
# `mirror` build stage (Dockerfile) instead of the public Terraform
# registry — apply-time `terraform init` never needs network egress to
# registry.terraform.io.
#
# Mirror coverage: the mirror is built from modules/tenant/versions.tf
# (6 providers: postgresql/rabbitmq/minio/vault/kubernetes/random),
# which is a superset of standalone/platform-secrets-apply's
# requirements (hashicorp/vault only) — so no direct {} fallback block
# is needed for either baked workspace.
provider_installation {
  filesystem_mirror {
    path    = "/opt/tf-plugin-mirror"
    include = ["*/*/*"]
  }
}

# Provider-plugin cache. The directory itself is TF_PLUGIN_CACHE_DIR on
# every subprocess (settings.computed_plugin_cache_dir — inside the
# writable workspace volume, since the root filesystem is read-only), so
# each pod unpacks the mirror ONCE and every workspace's
# .terraform/providers is a set of symlinks into it. Without this each
# `terraform init` unpacked ~200MiB into its own workspace and ~10
# tenants filled the 2Gi volume — kubelet then evicted the pod mid-apply.
#
# Every workspace here is generated fresh from the baked module (no
# .terraform.lock.hcl is ever committed or carried over), and since 1.4
# Terraform only reuses a cached package when the lock file already
# vouches for it. This is exactly the workflow the setting below exists
# for: a single platform (linux_amd64) installed from a pinned, baked
# mirror, so the "incomplete lock file" it warns about cannot arise.
plugin_cache_may_break_dependency_lock_file = true
